{
  "name": "@ton-primes/mcp",
  "version": "0.5.0",
  "mcpName": "io.github.KonnikPahoni/ton-primes",
  "type": "module",
  "description": "Model Context Protocol server for TON PRIMES: 23 tools over the game's published get-method projections, every write quoting before it spends.",
  "license": "MIT",
  "main": "src/index.ts",
  "bin": {
    "ton-primes-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsup",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@ton-primes/agent": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonnikPahoni/primes-contracts.git",
    "directory": "backend/mcp"
  },
  "homepage": "https://primes.live",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ton",
    "ton-blockchain",
    "agent",
    "ai-agent",
    "web3",
    "nft"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "bin": {
      "ton-primes-mcp": "dist/index.js"
    }
  },
  "bugs": {
    "url": "https://github.com/KonnikPahoni/primes-contracts/issues"
  }
}

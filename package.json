{
  "name": "primes-contracts",
  "private": true,
  "version": "0.0.0",
  "description": "TON PRIMES smart contracts (Tolk), wrappers, tests and the public audit pack",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "contracts",
    "shared"
  ],
  "scripts": {
    "test": "npm test -w contracts",
    "build": "npm run build -w contracts -- --all",
    "sim:trace": "cd sim && python3 scripts/export_trace.py --mode chain-replay --mints 2000",
    "test:full": "npm run sim:trace && npm test"
  },
  "devDependencies": {
    "@tact-lang/compiler": "1.6.13",
    "@ton-community/func-js": "0.11.0",
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@ton/tolk-js": "1.4.2"
  },
  "overrides": {
    "@ton/tolk-js": "1.4.2"
  }
}

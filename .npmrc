# @ton/blueprint 0.45.0 declares a peer of @ton/ton >=16.2.4 while the contracts pin
# ^15.4.0; the upstream monorepo (pnpm) installs with that peer mismatch as a warning.
# Peers blueprint needs (and the one @ton/core every package must share) are listed
# explicitly in the root package.json instead.
legacy-peer-deps=true
